<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Twist.App.Views.ProfileWindow"
        Icon="/Assets/twist.ico" Title="Profil" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Panel}">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="Body" TextWrapping="Wrap" IsVisible="False" />
    <StackPanel x:Name="NamePanel" Spacing="4">
      <TextBlock Classes="muted" Text="Nom du profil" />
      <TextBox x:Name="NameBox" Watermark="par exemple 70 cm, IC-9700…" />
    </StackPanel>
    <StackPanel x:Name="FromPanel" Spacing="6">
      <TextBlock Classes="muted" Text="Partir de" />
      <RadioButton x:Name="FromCopy" GroupName="from" IsChecked="True" />
      <RadioButton x:Name="FromDefaults" GroupName="from" Content="les réglages par défaut" />
    </StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" IsVisible="False" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Click="OnCancel">Annuler</Button>
      <Button x:Name="OkButton" Background="#1F6F8B" Foreground="White" FontWeight="SemiBold" Click="OnOk" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
