<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Twist.App.Views.DiagWindow"
        Icon="/Assets/twist.ico" Title="Diagnostic fbbspots" Width="720" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Panel}">
  <!-- Aide › Diagnostic fbbspots: each step, ✔ ⚠ ✘, and what it found -->
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
      <TextBlock Classes="h2" FontSize="18" Text="Connexion à fbbspots" />
      <TextBlock x:Name="Summary" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="CopyButton" Click="OnCopy">Copier</Button>
      <Button x:Name="AgainButton" Click="OnAgain">Relancer</Button>
      <Button Classes="ok" Click="OnClose">Fermer</Button>
    </StackPanel>
    <ScrollViewer>
      <ItemsControl x:Name="Lines">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
