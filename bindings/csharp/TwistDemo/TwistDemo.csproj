<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console demo of the C# bindings (../LibTwist.cs): decodes a WAV file
    or prints the chips of a frame through the native library.
      make                      (at the repository root: builds the library)
      cd bindings/csharp/TwistDemo
      dotnet run FILE.wav
    The libraries built by make (libtwcore, libtwist, libopera, libpi4)
    are copied next to the program.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../LibTwist.cs" />
    <!-- the native libraries built by make, copied next to the program when present -->
    <None Include="../../../libtwcore.*;../../../libtwist.*;../../../libopera.*;../../../libpi4.*" Exclude="../../../*.a" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
