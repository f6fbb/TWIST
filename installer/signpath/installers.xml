<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installers" (docs/SIGNING.md): the
     artifact unsigned-installers of the CI, TWIST-Console-<version>-setup.exe
     and, when there is one, TWIST-Console-<version>-mise-a-jour.exe. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="TWIST-Console-*-setup.exe" />
      <include path="TWIST-Console-*-mise-a-jour.exe" min-matches="0" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
